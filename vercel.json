{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "avrg.sofortsichtbar.de"
        }
      ]
    },
    {
      "source": "/:seite/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/schmid-raichle/",
      "has": [
        {
          "type": "host",
          "value": "avrg.sofortsichtbar.de"
        }
      ],
      "destination": "/sv-owen/schmid-raichle/",
      "permanent": true
    },
    {
      "source": "/precker/",
      "has": [
        {
          "type": "host",
          "value": "avrg.sofortsichtbar.de"
        }
      ],
      "destination": "/sv-owen/precker/",
      "permanent": true
    },
    {
      "source": "/maier/",
      "has": [
        {
          "type": "host",
          "value": "avrg.sofortsichtbar.de"
        }
      ],
      "destination": "/sv-owen/maier/",
      "permanent": true
    },
    {
      "source": "/hild/",
      "has": [
        {
          "type": "host",
          "value": "avrg.sofortsichtbar.de"
        }
      ],
      "destination": "/sv-owen/hild/",
      "permanent": true
    },
    {
      "source": "/bittner/",
      "has": [
        {
          "type": "host",
          "value": "avrg.sofortsichtbar.de"
        }
      ],
      "destination": "/sv-owen/bittner/",
      "permanent": true
    },
    {
      "source": "/koch/",
      "has": [
        {
          "type": "host",
          "value": "avrg.sofortsichtbar.de"
        }
      ],
      "destination": "/sv-owen/koch/",
      "permanent": true
    },
    {
      "source": "/impressum/",
      "has": [
        {
          "type": "host",
          "value": "avrg.sofortsichtbar.de"
        }
      ],
      "destination": "/sv-owen/impressum/",
      "permanent": true
    },
    {
      "source": "/datenschutz/",
      "has": [
        {
          "type": "host",
          "value": "avrg.sofortsichtbar.de"
        }
      ],
      "destination": "/sv-owen/datenschutz/",
      "permanent": true
    }
  ]
}
